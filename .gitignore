# Build artifacts (Go-built .so lives next to pytrivydb/ package dir)
build/
dist/
*.egg-info/
*.o
*.a
# Note: do NOT gitignore *.so / *.dylib / *.pyd globally — Phase 4 wheel
# builds need them. The build artifacts are workspace-local; gitignored
# below by directory:
pytrivydb/_pytrivydb*.so
pytrivydb/_pytrivydb*.dylib
pytrivydb/_pytrivydb*.pyd
pytrivydb/_pytrivydb_cffi.py
/pytrivydb.cpython-*.so
/pytrivydb.cpython-*.dylib
/pytrivydb.cpython-*.pyd
/pytrivydb*.so
/pytrivydb*.dylib
/pytrivydb*.pyd

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ty_cache/

# Virtual envs
.venv/
venv/

# uv
# uv.lock IS committed (dev dep reproducibility)

# Test fixtures (regenerated by `just regen-fixture`; built into
# pytrivydb/tests/fixtures/{trivy.db,metadata.json} by the Go writer)
pytrivydb/tests/fixtures/trivy.db
pytrivydb/tests/fixtures/metadata.json

